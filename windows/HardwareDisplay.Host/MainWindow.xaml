<Window x:Class="HardwareDisplay.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HardwareDisplay" Height="760" Width="1040" MinHeight="620" MinWidth="900"
        Background="#101217" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#101217" />
        <SolidColorBrush x:Key="Card" Color="#1A1E25" />
        <SolidColorBrush x:Key="Raised" Color="#222831" />
        <SolidColorBrush x:Key="Border" Color="#353E49" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F4F6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AFBBC5" />
        <SolidColorBrush x:Key="Accent" Color="#D4F86E" />
        <SolidColorBrush x:Key="Warn" Color="#FFCF79" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#101217" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="HardwareDisplay" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="Датчики этого ПК на экране телефона" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="20" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="{StaticResource Warn}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ServerStateText" Text="Сервер остановлен" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="20" Padding="14,8">
                    <TextBlock x:Name="SessionsText" Text="0 телефонов" Foreground="{StaticResource TextSecondary}"
                               FontSize="13" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="RefreshInviteButton" Content="Новый QR" Style="{StaticResource SecondaryButton}"
                                Click="OnRefreshInvite" Margin="0,0,10,0" />
                        <Button x:Name="ToggleServerButton" Content="Остановить сервер" Style="{StaticResource PrimaryButton}"
                                Click="OnToggleServer" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Подключение телефона" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Отсканируйте QR в приложении HardwareDisplay или введите данные вручную."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16" />

                            <Border Background="#FFFFFF" CornerRadius="12" Padding="10" HorizontalAlignment="Center">
                                <Image x:Name="QrImage" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Адрес" Style="{StaticResource Caption}" Margin="0,0,12,10" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AddressText" Text="—" Style="{StaticResource Mono}" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя ПК" Style="{StaticResource Caption}" Margin="0,0,12,10" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HostNameText" Text="—" Style="{StaticResource Mono}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Отпечаток" Style="{StaticResource Caption}" Margin="0,0,12,10" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FingerprintText" Text="—" Style="{StaticResource Mono}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Код" Style="{StaticResource Caption}" Margin="0,0,12,4" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InviteText" Text="—" Style="{StaticResource Mono}"
                                           Foreground="{StaticResource Accent}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InviteTimerText" Text="" Style="{StaticResource Caption}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Датчики" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="CollectorStateText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Text="сбор не запущен" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SensorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Raised}" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Сопряжённые телефоны" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <TextBlock x:Name="EmptyClientsText" Text="Пока ни один телефон не сопряжён."
                                   Style="{StaticResource Caption}" />
                        <ItemsControl x:Name="ClientList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Raised}" CornerRadius="12" Padding="16,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Отозвать" Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6" Tag="{Binding ClientId}" Click="OnRevokeClient" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="DiagnosticText" Text="" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="DataPathText" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
